    {
      "parameters": {
        "jsCode": "for (const item of $input.all()) {\n\n  const partidos = Number(item.json.partidos_jugados || 0);\n  const victorias = Number(item.json.victorias || 0);\n\n  let porcentaje = 0;\n\n  if (partidos > 0) {\n    porcentaje = (victorias / partidos) * 100;\n  }\n\n  item.json.porcentaje = porcentaje.toFixed(1);\n}\n\nreturn $input.all();"
