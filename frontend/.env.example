# ─────────────────────────────────────────────────────────────
#  PachangApp · Variables de entorno del Frontend
#
#  1. Copia este archivo a ".env" (sin el .example)
#  2. Rellena los valores con los de tu proyecto Supabase
#  3. En Vercel añade las mismas variables en:
#     Project Settings → Environment Variables
# ─────────────────────────────────────────────────────────────

# ── SUPABASE (OBLIGATORIO) ───────────────────────────────────
# Encuéntralos en: Supabase Dashboard → Settings → API
VITE_SUPABASE_URL=https://TU_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=TU_ANON_KEY_PUBLICA

# ── IA · PachanBot y Traductor (opcional, solo si usas la IA) ──
# Proveedor recomendado: Groq (gratis, rápido)
VITE_AI_KEY=gsk_tuClaveDeGroqAQUI
VITE_AI_URL=https://api.groq.com/openai/v1/chat/completions
VITE_AI_MODEL=llama-3.3-70b-versatile

# ── NOTA: ya NO necesitas VITE_API_BASE_URL (Render eliminado) ──
